{
  "name": "aria-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ARIA — Adaptive Responsive Intelligence for Attachment. Child-AI interaction system.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:face": "pnpm --filter @aria/face-app start",
    "dev:parent": "pnpm --filter @aria/parent-dashboard start",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run type-check",
    "test": "pnpm -r --if-present run test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
